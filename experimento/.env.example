# Configuração do pipeline de experimentos (modo produção)
# Copie para .env e ajuste conforme necessário.

# Número de rodadas de repetição estatística por cenário/perfil
RUNS=50
# Quantidade de lotes de eventos no Infinite Scroll
SCROLL_BATCHES=50
# Quantidade de mutações de inscrição/cancelamento
MUTATIONS=20

# Filtros de execução (padrão: all)
# EXPERIMENT: 'all', 'cold-start', 'infinite-scroll', 'mutacao-estado'
EXPERIMENT=all
# TECH: 'all', 'htmx', 'react'
TECH=all
# PROFILES: 'all', 'NoThrottling', 'Fast4G', 'Slow4G'
PROFILES=all
# Pular análises estatísticas ao final (0 = não pular, 1 = pular)
SKIP_ANALYSIS=0

# Isolamento de recursos por container de servidor (metodologia do TCC)
SERVER_CPU_LIMIT=2.0
SERVER_MEM_LIMIT=2048M
