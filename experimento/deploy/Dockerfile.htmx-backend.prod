# syntax=docker/dockerfile:1.5
# Dockerfile de producao para o EventFlow HTMX Backend (Django + Gunicorn).
# O codigo-fonte vem do contexto nomeado `source` = ../eventflow-htmx.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=source . .

# Gunicorn (WSGI de producao). Arquivos estaticos e midias sao servidos diretamente pelo Nginx.
RUN pip install --no-cache-dir -r requirements.txt gunicorn

EXPOSE 8000
