# Imagem do orquestrador/coletor (Playwright Linux + stack de analise).
# Executa coleta, analise estatistica, graficos e tabelas em modo producao.
FROM mcr.microsoft.com/playwright/python:v1.49.1-noble

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt /app/
RUN apt-get update && apt-get install -y --no-install-recommends tcpdump iproute2 && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt && python -m playwright install chromium

COPY . /app/

CMD ["python", "run.py"]
